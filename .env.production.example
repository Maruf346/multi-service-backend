# GoSwift backend production environment template.
# Copy to /opt/goswift-backend/.env.production on EC2 and fill real values there.

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DEBUG=False
ALLOWED_HOSTS=YOUR_ELASTIC_IP,localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

CORS_ALLOWED_ORIGINS=http://YOUR_ELASTIC_IP,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
WEBSOCKET_ALLOWED_ORIGINS=http://YOUR_ELASTIC_IP,ws://YOUR_ELASTIC_IP,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,ws://localhost:3000,ws://127.0.0.1:3000,ws://localhost:5173,ws://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://YOUR_ELASTIC_IP

BASE_URL=http://YOUR_ELASTIC_IP/
FRONTEND_URL=http://YOUR_FRONTEND_OR_PLACEHOLDER

DB_ENGINE=django.db.backends.postgresql
DB_NAME=goswift
DB_USER=goswift_admin
DB_PASSWORD=CHANGE_ME
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
USE_REDIS_CHANNELS=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=YOUR_GMAIL_ADDRESS
EMAIL_HOST_PASSWORD=YOUR_GMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=GoSwift <YOUR_GMAIL_ADDRESS>

USE_S3_MEDIA=True
AWS_STORAGE_BUCKET_NAME=goswift-media-YOUR_SUFFIX
AWS_S3_REGION_NAME=YOUR_AWS_REGION
# Prefer an EC2 instance role for S3 access. Leave these blank when using the role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
